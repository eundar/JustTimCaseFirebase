rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAttorney() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/attorneys/$(request.auth.uid));
    }

    // Every attorney can open and remove any document; uploads still go under
    // the uploader's own folder.
    match /documents/{ownerId}/{allPaths=**} {
      allow read, delete: if isAttorney();
      allow create, update: if isAttorney() && request.auth.uid == ownerId;
    }
  }
}

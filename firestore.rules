rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAttorney() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/attorneys/$(request.auth.uid));
    }

    function validAttorneyProfile() {
      return request.resource.data.keys().hasAll([
          'name',
          'specialization',
          'email'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name',
          'specialization',
          'email'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.specialization is string &&
        request.resource.data.email is string;
    }

    // New records are stamped with the attorney who created them.
    function ownsNewRecord() {
      return isAttorney() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    function preservesOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // Anyone with an attorneys/{uid} profile is a firm member with access to
    // every feature. Profiles are readable firm-wide but self-managed.
    match /attorneys/{uid} {
      allow read: if isAttorney() ||
        (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        validAttorneyProfile();
      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        validAttorneyProfile();

      match /{document=**} {
        allow read, write: if isAttorney();
      }
    }

    // Firm-wide data: every attorney can read and manage every record.
    match /clients/{docId} {
      allow read, delete: if isAttorney();
      allow create: if ownsNewRecord();
      allow update: if isAttorney() && preservesOwner();
    }

    match /cases/{docId} {
      allow read, delete: if isAttorney();
      allow create: if ownsNewRecord();
      allow update: if isAttorney() && preservesOwner();
    }

    match /appointments/{docId} {
      allow read, delete: if isAttorney();
      allow create: if ownsNewRecord();
      allow update: if isAttorney() && preservesOwner();
    }

    match /documents/{docId} {
      allow read, delete: if isAttorney();
      allow create: if ownsNewRecord();
      allow update: if isAttorney() && preservesOwner();
    }

    match /prospectiveClients/{docId} {
      // Public intake creation is schema-limited; review requires a trusted claim.
      allow create: if request.resource.data.keys().hasAll([
          'fullName',
          'email',
          'phone',
          'caseType',
          'caseDescription',
          'privacyAgreementAccepted',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'phone',
          'caseType',
          'caseDescription',
          'opposingParty',
          'privacyAgreementAccepted',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 32 &&
        request.resource.data.caseDescription is string &&
        request.resource.data.caseDescription.size() > 0 &&
        request.resource.data.caseDescription.size() <= 10000 &&
        request.resource.data.caseType in [
          'Criminal',
          'Civil',
          'Family',
          'Corporate',
          'Labor',
          'Property',
          'Immigration',
          'Intellectual Property',
          'Other'
        ] &&
        request.resource.data.privacyAgreementAccepted == true &&
        request.resource.data.status == 'Pending Review' &&
        request.resource.data.createdAt is string &&
        (
          !('opposingParty' in request.resource.data) ||
          (request.resource.data.opposingParty is string &&
            request.resource.data.opposingParty.size() <= 200)
        );

      // Intake review is open to every attorney.
      allow read, delete: if isAttorney();
      allow update: if isAttorney() &&
        resource.data.status == 'Pending Review' &&
        request.resource.data.status in ['Accepted', 'Declined'] &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status']);
    }
  }
}
